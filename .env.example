# Vorlage. Kopieren nach .env.local und mit den echten Werten fuellen.
# .env.local wird nie ins Repo eingecheckt.

# Supabase: Projekteinstellungen -> API
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Generalschluessel der Datenbank. Nur serverseitig, niemals im Browser.
SUPABASE_SECRET_KEY=

# Basis-URL der App. Erst die Vercel-URL, spaeter die Clubsubdomain.
# Die QR-Codes werden ausschliesslich aus diesem Wert gebaut.
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# Wird erst ab Etappe 3 gelesen, jetzt schon anlegen spart spaeteres Nachtragen.
CLUB_PIN=
ADMIN_PIN=
